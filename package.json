{
  "name": "revision-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mindgym": "npm run dev -w mindgym",
    "dev:contextmagic": "npm run dev -w contextmagic",
    "build:mindgym": "npm run build -w mindgym",
    "build:contextmagic": "npm run build -w contextmagic",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
